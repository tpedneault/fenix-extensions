# name: Kubernetes Deployment
# key: deployment
# scope: yaml
# --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${1:app}
spec:
  replicas: ${2:1}
  selector:
    matchLabels:
      app: $1
  template:
    metadata:
      labels:
        app: $1
    spec:
      containers:
        - name: $1
          image: ${3:registry.example.com/app:latest}
          ports:
            - containerPort: ${4:8080}
$0